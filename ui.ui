            <property name="text">
             <string>输出名称:</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="nameEdit"/>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QGroupBox" name="modeGroup">
          <property name="title">
           <string>打包模式</string>
          </property>
          <layout class="QHBoxLayout" name="horizontalLayout_4">
           <item>
            <widget class="QRadioButton" name="standaloneRadio">
             <property name="text">
              <string>独立应用 (--standalone)</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QRadioButton" name="onefileRadio">
             <property name="text">
              <string>单文件 (--onefile)</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="optGroup">
          <property name="title">
           <string>优化选项</string>
          </property>
          <layout class="QGridLayout" name="gridLayout">
           <item row="0" column="0">
            <widget class="QCheckBox" name="ltoChk">
             <property name="text">
              <string>链接时优化 (--lto)</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QCheckBox" name="stripChk">
             <property name="text">
              <string>去除符号 (--strip)</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QCheckBox" name="removeOutputChk">
             <property name="text">
              <string>移除输出目录 (--remove-output)</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QCheckBox" name="noassertChk">
             <property name="text">
              <string>移除断言 (--no-asserts)</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="osGroup">
          <property name="title">
           <string>操作系统选项</string>
          </property>
          <layout class="QHBoxLayout" name="horizontalLayout_5">
           <item>
            <widget class="QCheckBox" name="winConsoleChk">
             <property name="text">
              <string>不显示控制台 (--windows-console)</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="winUacAdminChk">
             <property name="text">
              <string>请求管理员权限 (--windows-uac-admin)</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="pluginTab">
       <attribute name="title">
        <string>插件设置</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayout_3">
        <item>
         <widget class="QGroupBox" name="pluginGroup">
          <property name="title">
           <string>启用插件</string>
          </property>
          <layout class="QGridLayout" name="gridLayout_2">
           <item row="0" column="0">
            <widget class="QCheckBox" name="tkInterChk">
             <property name="text">
