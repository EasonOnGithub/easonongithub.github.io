            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QCheckBox" name="numpyChk">
             <property name="text">
              <string>NumPy (numpy)</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QCheckBox" name="pandasChk">
             <property name="text">
              <string>Pandas (pandas)</string>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QCheckBox" name="djangoChk">
             <property name="text">
              <string>Django (django)</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QCheckBox" name="multiprocessingChk">
             <property name="text">
              <string>多进程 (multiprocessing)</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="includeGroup">
          <property name="title">
           <string>包含数据</string>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_4">
           <item>
            <layout class="QHBoxLayout" name="horizontalLayout_6">
             <item>
              <widget class="QLabel" name="includeLbl">
               <property name="text">
                <string>包含文件/目录:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLineEdit" name="includeEdit">
               <property name="placeholderText">
                <string>注意：不能同时导入文件和目录！</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="includeBtn_2">
               <property name="text">
                <string>浏览</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="includeBtn">
               <property name="text">
                <string>添加</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QListWidget" name="includeList"/>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="advTab">
       <attribute name="title">
        <string>高级设置</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayout_5">
        <item>
         <widget class="QGroupBox" name="debugGroup">
          <property name="title">
           <string>调试选项</string>
          </property>
          <layout class="QGridLayout" name="gridLayout_4">
           <item row="0" column="0">
            <widget class="QCheckBox" name="showProgressChk">
             <property name="text">
              <string>显示进度 (--show-progress)</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QCheckBox" name="showMemoryChk">
             <property name="text">
              <string>显示内存使用 (--show-memory)</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0" colspan="2">
            <widget class="QCheckBox" name="verboseChk">
             <property name="text">
              <string>详细输出 (--verbose)</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="otherGroup">
          <property name="title">
           <string>其他选项</string>
          </property>
          <layout class="QGridLayout" name="gridLayout_5">
           <item row="0" column="0">
            <widget class="QLabel" name="jobsLbl">
             <property name="text">
              <string>并行作业数:</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QSpinBox" name="jobsSpin">
             <property name="minimum">
              <number>1</number>
             </property>
             <property name="maximum">
              <number>64</number>
             </property>
             <property name="value">
              <number>1</number>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="iconLbl">
             <property name="text">
              <string>图标文件:</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLineEdit" name="iconEdit"/>
           </item>
           <item row="1" column="2">
            <widget class="QPushButton" name="iconBtn">
             <property name="text">
              <string>浏览...</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
